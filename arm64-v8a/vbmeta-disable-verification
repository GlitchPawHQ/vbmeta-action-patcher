#!/system/bin/sh
# Patch an AVB vbmeta image to set disable-verity and disable-verification.
# Compatible with Android/TWRP /system/bin/sh and ordinary POSIX sh.
# Usage: sh vbmeta-disable-verification.sh input-vbmeta.img [output-vbmeta.img]
# The input is never modified; output must not already exist.

set -eu

usage() {
    echo "Usage: sh $0 <input-vbmeta.img> [output-vbmeta.img]" >&2
    echo "Creates a patched copy; the original image is left unchanged." >&2
}

fail() {
    echo "Error: $*" >&2
    exit 1
}

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    usage
    exit 2
fi

input=$1
output=${2:-"${input}.disabled"}

[ -f "$input" ] || fail "Input file not found: $input"
[ -r "$input" ] || fail "Input file is not readable: $input"
[ "$input" != "$output" ] || fail "Input and output paths must be different."
[ ! -e "$output" ] || fail "Output already exists: $output (choose a new output path)."

# AVB vbmeta header: magic "AVB0" at offset 0; flags byte is at offset 123.
size=$(wc -c < "$input" | tr -d '[:space:]')
case "$size" in
    ''|*[!0-9]*) fail "Could not determine input file size." ;;
esac
[ "$size" -ge 124 ] || fail "File is too small to be a vbmeta image (need at least 124 bytes)."

magic=$(od -An -tc -N 4 "$input" | tr -d '[:space:]')
[ "$magic" = "AVB0" ] || fail "Input does not start with the AVB0 vbmeta magic."

current=$(od -An -tu1 -j 123 -N 1 "$input" | tr -d '[:space:]')
case "$current" in
    ''|*[!0-9]*) fail "Could not read the vbmeta flags byte." ;;
esac

# Bit 0 disables dm-verity; bit 1 disables AVB verification.
new=$((current | 3))

cp "$input" "$output" || fail "Could not copy input to output: $output"
if ! printf "\\$(printf '%03o' "$new")" | dd of="$output" bs=1 seek=123 conv=notrunc 2>/dev/null; then
    rm -f "$output"
    fail "Failed to write patched flags; incomplete output removed."
fi

verified=$(od -An -tu1 -j 123 -N 1 "$output" | tr -d '[:space:]')
if [ "$verified" != "$new" ]; then
    rm -f "$output"
    fail "Verification of the patched output failed; output removed."
fi

echo "Successfully patched vbmeta image."
echo "Input:  $input"
echo "Output: $output"
echo "Flags byte: $current -> $verified"
echo "The input file was not modified."
echo "Warning: disabling these flags weakens Android Verified Boot protections."
